# Vercel/local partner mode: keep this empty so /api/v2 stays same-origin
# and set VITE_PARTNER_PORTAL_ENABLED=true.
# GitHub Pages public-only mode: use the complete Heroku origin and set
# VITE_PARTNER_PORTAL_ENABLED=false. Cross-origin public requests omit cookies.
# Never use /api because API methods already contain the /api/v2 prefix.
VITE_API_ORIGIN=
VITE_PARTNER_PORTAL_ENABLED=true
# Development server only. Vercel instead sets BACKEND_ORIGIN as a server-side
# Function runtime variable; do not create VITE_BACKEND_ORIGIN.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_MAPBOX_ACCESS_TOKEN=
VITE_PASSWORD_RESET_URL=
VITE_INTERNAL_DASHBOARD_URL=
VITE_SHOW_API_ORIGIN=false
# Temporary browser-console diagnostics. Values and invitation tokens are not logged.
VITE_API_DEBUG=false
